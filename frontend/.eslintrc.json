{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".vscode",
    "*.config.js",
    "*.config.ts",
    "index.html"
  ]
}
